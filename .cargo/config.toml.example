# Copy to .cargo/config.local.toml; adjust sibling paths for your layout.
# Run python scripts/cargo_mode.py local check --workspace (Python 3.11+, Cargo 1.97+).
# The launcher keeps the portable Cargo.lock unchanged and selects a local lock.
# Local Cargo config (gitignored, local-dev only) — mirrors mere's.
#
# Turnstone's committed manifest resolves owned sibling repos from GitHub so a
# clean checkout builds anywhere. This local file redirects those git sources
# to sibling working copies beside this checkout for the
# cross-repo edit loop.

[patch."https://github.com/merely-made/netrender.git"]
netrender = { path = "../netrender/netrender" }
netrender_device = { path = "../netrender/netrender_device" }
paint_list_api = { path = "../netrender/paint_list_api" }
paint_list_render = { path = "../netrender/paint_list_render" }

[patch."https://github.com/merely-made/wgpu-scry.git"]
scrying = { path = "../wgpu-scry/scrying" }

[patch."https://github.com/merely-made/wgpu-graft.git"]
grafting = { path = "../wgpu-graft/grafting" }

[patch."https://github.com/merely-made/wgpu-weld.git"]
welding = { path = "../wgpu-weld/welding" }

[patch.crates-io]
# Keep the crates.io-facing half of Turnstone's committed Netrender family
# patch on the same local source as the git-facing half above. Cargo does not
# recursively apply a crates.io -> git patch through a git -> path patch.
netrender = { path = "../netrender/netrender" }
netrender_device = { path = "../netrender/netrender_device" }
paint_list_api = { path = "../netrender/paint_list_api" }
paint_list_render = { path = "../netrender/paint_list_render" }
# p2panda fork, local working copy — mirrors mere's config; the committed
# manifest repoints these at mark-ik/p2panda and this redirects to the clone.
# The family patches together or not at all: local p2panda-net path-deps its
# siblings, so patching one alone yields two p2panda-core copies.
# Corrected 2026-08-01: these read `repos/p2panda` (empty since the 2026-07-23
# consolidation moved forks to `crates/`), so turnstone would not resolve at
# all. Forks live in `Code/crates/`; own projects live in `Code/repos/`.
p2panda-auth = { path = "../../crates/p2panda/p2panda-auth" }
p2panda-core = { path = "../../crates/p2panda/p2panda-core" }
p2panda-discovery = { path = "../../crates/p2panda/p2panda-discovery" }
p2panda-encryption = { path = "../../crates/p2panda/p2panda-encryption" }
mere-p2panda-net = { path = "../../crates/p2panda/p2panda-net" }
p2panda-store = { path = "../../crates/p2panda/p2panda-store" }
p2panda-stream = { path = "../../crates/p2panda/p2panda-stream" }
p2panda-sync = { path = "../../crates/p2panda/p2panda-sync" }
# The physics + field siblings live in conatus; mere patches these too, and
# merecat must agree or it silently builds against the published crates and
# cannot see local seiche work (e.g. AnchorSpring). The family patches
# together or not at all: local seiche path-deps local numen/quint, so
# patching one alone yields two copies of the same types
# ("expected numen::coupling::CouplingResponse, found CouplingResponse").
# Mirrors mere's set exactly.
# Genet's vendored Taffy fork is published and locally named `genet-taffy`.
# Keep local Livery on the same source and package identity as the committed
# manifest while developing against the Genet checkout.

# LNK1140: the test binary's program database hit MSVC's page cap the day the
# livery cutover landed (the graph gained genet-winit-host and friends).
# Raising the page size is Microsoft's documented remedy and keeps debug info;
# it pairs with the workspace's line-tables-only profile.
[target.x86_64-pc-windows-msvc]

