# Build output of every workspace root, nested ones too (the app's web root, the coop
# relay server): target/ at every level (engine split D123).
target/
# Portable root lock is tracked; local mode has a separate ignored lock.
# Local-dev sibling patches (mirrors mere's convention): committed manifests
# resolve owned sibling repos from GitHub; this file redirects them to the
# working copies under repos/ for the cross-repo edit loop.
/.cargo/*
!/.cargo/config.toml.example
**/.cargo/local/
**/.cargo/config.local.toml
/target-*/

# Generated fixture bytecode.
scenarios/fixtures/document_a11y/__pycache__/
/scripts/__pycache__/

# Local output directory for run receipts; tracked receipts live in Code/testing/turnstone/receipts/.
/docs/receipts/
