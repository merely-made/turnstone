+    fn resource_views() -> (Graph, mere::kernel::graph::NodeKey, mere::kernel::graph::NodeKey) {
+        use mere::kernel::graph::apply::add_node;
+        let mut graph = Graph::new();
+        let a = add_node(&mut graph, None, "https://example.test/page#one".into(), Default::default());
+        let b = add_node(&mut graph, None, "https://example.test/page#two".into(), Default::default());
