+        if probe.is_some() {
+            use webview2_com::Microsoft::Web::WebView2::Win32::ICoreWebView2_13;
+            use windows::core::Interface;
+            let facts = (|| -> windows::core::Result<_> {
+                let view = producer.borrow().webview().cast::<ICoreWebView2_13>()?;
