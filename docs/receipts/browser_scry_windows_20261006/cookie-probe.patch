     fn new(producer: Rc<RefCell<PlatformWebSurfaceProducer>>) -> Self {
+        let probe =
+            (std::env::var("TURNSTONE_SCRY_COOKIE_PROBE").as_deref() == Ok("1")).then(|| {
+                CookieProbe {
+                    next: Instant::now(),
+                    pending: false,
+                }
