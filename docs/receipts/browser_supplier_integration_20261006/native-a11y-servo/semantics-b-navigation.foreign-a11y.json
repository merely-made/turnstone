              "children": [],
              "graft_tree_id": null,
              "label": null,
              "value": "\n(() => {\n  const query = new URLSearchParams(location.search);\n  const page = query.get('page') === 'B' ? 'B' : 'A';\n  const result = query.get('result');\n  document.documentElement.dataset.page = page;\n  document.querySelector('.top').textContent = `TOP ${page}: red`;\n  document.querySelector('.bottom').textContent = `BOTTOM ${page}: blue`;\n  document.title = `Servo ${page} semantics${result === null ? '' : ' result'}`;\n  document.querySelector('#heading').textContent = `Servo ${page} semantics`;\n  document.querySelector('#state').textContent = result === null\n    ? `DOM-only ${page} initial` : `DOM-only ${page} result ${result}`;\n  const entry = document.querySelector('#entry');\n  entry.addEventListener('input', () => {\n    // This semantic change deliberately leaves the native title unchanged.\n    const text = entry.value;\n    setTimeout(() => { document.querySelector('#state').textContent = `DOM-only ${page} idle ${text}`; }, 200);\n  });\n  document.querySelector('#activate').addEventListener('click', () => {\n    const target = new URL('a11y.html', location.href);\n    target.searchParams.set('page', page);\n    target.searchParams.set('result', entry.value);\n    location.href = target.href;\n  });\n})();\n",
