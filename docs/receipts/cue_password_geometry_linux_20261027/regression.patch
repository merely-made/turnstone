+#[test]
+fn password_caret_projection_refreshes_same_mask_and_covers_partial_graphemes() {
+    let mut dom = ScriptedDom::from_serialized_document(
+        "<html><body><input id=secret type=password value=abc></body></html>",
+    );
+    let secret = by_id(&dom, "secret");
+    let mut document = form_control_paint_document(
+        dom, "html,body { margin:0 } input { display:block; width:240px; height:28px }",
+        400.0, 120.0,
+    );
+    document.frame(400, 120).unwrap();
+    let end = document.caret_rect(secret, 3).unwrap();
+    let value = "e\u{0301}😀z";
+    document.mutate_dom(|dom| {
+        let mut state = dom.form_control_state(secret).unwrap();
+        state.value = value.into();
+        state.dirty_value = true;
+        assert!(dom.set_form_control_state(secret, state));
+    });
+    document.frame(400, 120).unwrap();
+    let refreshed = document.caret_rect(secret, value.len()).unwrap();
+    assert!((end.x - refreshed.x).abs() < 0.01, "unchanged mask retains its shaped width");
+    assert_eq!(document.text_position_at_point(refreshed.x, refreshed.y + refreshed.height * 0.5),
+        Some((secret, value.len())), "same-mask edits must refresh the inverse offset map");
+    let start = document.caret_rect(secret, 0).unwrap();
+    for byte in [1, 2] {
+        assert!((document.caret_rect(secret, byte).unwrap().x - start.x).abs() < 0.01,
+            "an interior source position stays at the leading masked edge");
+    }
+    let partial = document.selection_for_range(TextRange {
+        anchor_node: secret, anchor_offset: 1, focus_node: secret, focus_offset: 2,
+    }).unwrap();
+    assert_eq!(partial.text, "•", "a partial grapheme selection covers its whole masked glyph");
+    document.mutate_dom(|dom| {
+        dom.set_attribute(secret, attr("type"), "text");
+    });
+    document.frame(400, 120).unwrap();
+    let plain = document.selection_for_range(TextRange {
+        anchor_node: secret, anchor_offset: 0, focus_node: secret, focus_offset: value.len(),
+    }).unwrap();
+    assert_eq!(plain.text, value, "changing type removes the password projection");
+}
