+#[cfg(test)]
+mod resource_capture_tests {
+    use super::*;
+    use mere::kernel::graph::apply::apply_graph_delta;
+
+    fn add_surface(graph: &mut Graph, serial: u128, url: &str) -> (uuid::Uuid, uuid::Uuid) {
+        let surface = uuid::Uuid::from_u128(serial);
+        let capture = CapturedDelta::ReplayAddNodeWithIdIfMissing {
+            id: surface.to_string(),
+            url: url.into(),
+            position: [0.0, 0.0],
+        };
+        apply_graph_delta(graph, capture.replay_delta().unwrap());
+        let key = graph.get_node_key_by_id(surface).unwrap();
+        (surface, graph.shown_resource_id(key).unwrap())
+    }
+
+    fn aliases(graph: &mut Graph) -> (uuid::Uuid, uuid::Uuid, uuid::Uuid) {
+        let (first, resource) = add_surface(graph, 1, "https://example.org/page?id=1");
+        let (second, alias) = add_surface(
+            graph,
+            2,
+            "https://EXAMPLE.ORG:443/page?utm_source=news&id=1#fragment",
+        );
+        assert_eq!(resource, alias);
+        (first, second, resource)
+    }
+
+    fn resource_change(resource: uuid::Uuid) -> CapturedDelta {
+        CapturedDelta::ReplaySetResourceRecordById {
+            resource_id: resource.to_string(),
+            record: None,
+        }
+    }
+
+    #[test]
+    fn a_resource_record_wakes_all_alias_surfaces_and_not_an_unrelated_surface() {
+        let mut graph = Graph::new();
+        let (first, second, resource) = aliases(&mut graph);
+        let (unrelated, _) = add_surface(&mut graph, 3, "https://example.org/other");
+        let ids = touched_ids(&graph, &resource_change(resource));
+        assert_eq!(ids, vec![first.to_string(), second.to_string()]);
+        assert!(!ids.contains(&unrelated.to_string()));
+    }
+
+    #[test]
+    fn resource_pairs_union_both_endpoint_surfaces_and_deduplicate_self_pairs() {
+        let mut graph = Graph::new();
+        let (first, second, resource) = aliases(&mut graph);
+        let (third, other) = add_surface(&mut graph, 3, "https://example.org/other");
+        let pair = |to: uuid::Uuid| CapturedDelta::ReplaySetResourceEdgesByIds {
+            from_resource_id: resource.to_string(),
+            to_resource_id: to.to_string(),
+            edges: Vec::new(),
+        };
+        assert_eq!(
+            touched_ids(&graph, &pair(other)),
+            vec![first.to_string(), second.to_string(), third.to_string()]
+        );
+        assert_eq!(
+            touched_ids(&graph, &pair(resource)),
+            vec![first.to_string(), second.to_string()]
+        );
+    }
+
+    #[test]
+    fn malformed_or_unshown_resource_ids_do_not_become_bare_surface_wakes() {
+        let mut graph = Graph::new();
+        let (first, second, resource) = aliases(&mut graph);
+        let malformed = CapturedDelta::ReplaySetResourceRecordById {
+            resource_id: "not-a-resource-uuid".into(),
+            record: None,
+        };
+        assert!(touched_ids(&graph, &malformed).is_empty());
+        assert!(touched_ids(&graph, &resource_change(uuid::Uuid::from_u128(99))).is_empty());
+        let pair = CapturedDelta::ReplaySetResourceEdgesByIds {
+            from_resource_id: "invalid".into(),
+            to_resource_id: resource.to_string(),
+            edges: Vec::new(),
+        };
+        assert_eq!(
+            touched_ids(&graph, &pair),
+            vec![first.to_string(), second.to_string()]
+        );
+    }
+
+    #[test]
+    fn shown_resource_retarget_and_clear_wake_only_the_named_surface() {
+        let mut graph = Graph::new();
+        let (first, second, old_resource) = aliases(&mut graph);
+        let (third, new_resource) = add_surface(&mut graph, 3, "https://example.org/other");
+        for shown in [Some(new_resource.to_string()), None] {
+            let capture = CapturedDelta::ReplaySetShownResourceById {
+                surface_id: first.to_string(),
+                resource_id: shown.clone(),
+            };
+            apply_graph_delta(&mut graph, capture.replay_delta().unwrap());
+            assert_eq!(touched_ids(&graph, &capture), vec![first.to_string()]);
+            assert_eq!(
+                touched_ids(&graph, &resource_change(old_resource)),
+                vec![second.to_string()]
+            );
+            let expected_new = if shown.is_some() {
+                vec![first.to_string(), third.to_string()]
+            } else {
+                vec![third.to_string()]
+            };
+            assert_eq!(
+                touched_ids(&graph, &resource_change(new_resource)),
+                expected_new
+            );
+        }
+    }
+
+    #[test]
+    fn legacy_surface_and_exact_edge_captures_keep_their_targets() {
+        let graph = Graph::new();
+        let first = uuid::Uuid::from_u128(1).to_string();
+        let second = uuid::Uuid::from_u128(2).to_string();
+        let old = CapturedDelta::ReplaySetEdgesByIds {
+            from_id: first.clone(),
+            to_id: second.clone(),
+            edges: Vec::new(),
+        };
+        assert_eq!(touched_ids(&graph, &old), vec![first.clone(), second]);
+        let removed = CapturedDelta::ReplayRemoveNodeById {
+            node_id: first.clone(),
+        };
+        assert_eq!(touched_ids(&graph, &removed), vec![first.clone()]);
+        assert_eq!(ancestry_scopes(&graph, &first)[0].segments(), &[first]);
+        assert!(ancestry_scopes(&graph, "invalid-surface").is_empty());
+    }
+
+    #[test]
+    fn expanded_surface_scopes_keep_watch_matching_and_no_self_wake() {
+        let mut graph = Graph::new();
+        let (first, second, resource) = aliases(&mut graph);
+        let subject = servitor::Subject::new([0x31; 32]);
+        let scopes = touched_ids(&graph, &resource_change(resource))
+            .into_iter()
+            .flat_map(|id| ancestry_scopes(&graph, &id))
+            .collect::<Vec<_>>();
+        let human = servitor::cascade::CommittedEntry::new(1, "human", scopes.clone());
+        let own = servitor::cascade::CommittedEntry::new(2, subject.to_hex(), scopes);
+        for surface in [first, second] {
+            let watch = servitor::Watch {
+                subject,
+                scope: servitor::ScopePath::parse(&surface.to_string()).unwrap(),
+                self_author: subject.to_hex(),
+                cursor: 0,
+            };
+            assert!(watch.matches(&human.as_event()));
+            assert!(!watch.matches(&own.as_event()));
+        }
+    }
+}
