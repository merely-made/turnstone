+/// Resource identities are not behavior scopes. Resolve them through the
+/// graph's current shown-resource mapping, then deduplicate before ancestry.
+fn surfaces_for_resources(graph: &Graph, resources: &[&str]) -> Vec<String> {
+    resources
+        .iter()
+        .filter_map(|id| id.parse::<uuid::Uuid>().ok())
+        .flat_map(|id| graph.surface_ids_showing_resource(id))
+        .collect::<std::collections::BTreeSet<_>>()
+        .into_iter()
+        .map(|id| id.to_string())
+        .collect()
