+//! Private diagnostic: compare a fresh sampler and fresh full-packet lowering
+//! against the unchanged original child capture. No source/registry changes.
+use cambium_genet_winit_host::HostHooks;
+use std::{
+    cell::RefCell,
+    path::PathBuf,
+    rc::Rc,
+    time::{Duration, Instant},
+};
+use tabard_workshop::{WorkshopState, WorkshopView, native_host::WorkshopLogic};
+const CSS_IMAGE: u64 = 0xc000_0000_7461_6263;
+const PROBE_RASTER: u64 = 0x7461_6200_7374_0001;
+struct Copy {
+    label: &'static str,
+    pending: cambium_rootstock::PendingFrame,
+    armed: Instant,
+    mapped: Option<cambium_rootstock::Frame>,
+    mapped_ms: Option<u128>,
+}
+struct StageProbe {
+    directory: PathBuf,
+    claimed: bool,
+    copies: Option<Vec<Copy>>,
+    metadata: serde_json::Value,
+}
+
+/// Call only after constructing the existing lane's after_frame wrapper.
+pub(super) fn install(hooks: &mut HostHooks<WorkshopState, WorkshopLogic, WorkshopView>) {
+    let Some(directory) = std::env::var_os("TURNSTONE_THEME_STAGE_PROBE_DIR") else {
+        return;
+    };
+    let probe = Rc::new(RefCell::new(StageProbe {
+        directory: PathBuf::from(directory),
+        claimed: false,
+        copies: None,
+        metadata: serde_json::Value::Null,
+    }));
+    // Store the actual translated packet, retaining its font/image assets.
+    // Translation is CPU-only and does not call any source frame callback.
+    let scene: Rc<RefCell<Option<(netrender::Scene, usize)>>> = Rc::new(RefCell::new(None));
+    let mut previous = std::mem::replace(&mut hooks.after_frame, Box::new(|_| {}));
+    hooks.after_frame = Box::new(move |ctx| {
+        previous(ctx); // Mesquite has now armed this turn's capture requests.
+        probe.borrow_mut().poll();
+        if probe.borrow().claimed || (!ctx.capture_stamped.is_some() && !ctx.capture.is_some()) {
+            return;
+        }
+        if let Some(original) = ctx.capture_paint.take() {
+            let sink = scene.clone();
+            *ctx.capture_paint = Some(Box::new(move |envelope| {
+                let translated = paint_list_render::translate_paint_cmd_stream(
+                    envelope.viewport,
+                    &envelope.commands,
+                    &envelope.fonts,
+                    &envelope.images,
+                );
+                *sink.borrow_mut() = Some((translated.scene, translated.box_shadow_masks.len()));
+                original(envelope);
+            }));
+        }
+        let mode = ctx.runner.state().mode_key().to_owned();
+        probe.borrow_mut().claimed = true;
+        if let Some(original) = ctx.capture_stamped.take() {
+            let sink = probe.clone();
+            let scene = scene.clone();
+            *ctx.capture_stamped = Some(Box::new(move |surface, view, presentation| {
+                original(surface, view, presentation); // Freeze original child bytes FIRST.
+                sink.borrow_mut().arm(surface,presentation.width,presentation.height,presentation.layout_scale,
+                    serde_json::json!({"capture_kind":"stamped","mode":mode,"host":presentation.host,"sequence":presentation.sequence,"width":presentation.width,"height":presentation.height,"layout_scale":presentation.layout_scale}),scene.borrow_mut().take());
+            }));
+        } else if let Some(original) = ctx.capture.take() {
+            let sink = probe.clone();
+            let scene = scene.clone();
+            *ctx.capture = Some(Box::new(move |surface, view, width, height| {
+                original(surface, view, width, height);
+                sink.borrow_mut().arm(surface,width,height,2.0,
+                    serde_json::json!({"capture_kind":"legacy","mode":mode,"width":width,"height":height,"layout_scale":"assumed2; requirewide2360"}),scene.borrow_mut().take());
+            }));
+        }
+    });
+}
+impl StageProbe {
+    fn arm(
+        &mut self,
+        surface: &dyn cambium_rootstock::Surface,
+        width: u32,
+        height: u32,
+        scale: f32,
+        parent: serde_json::Value,
+        captured: Option<(netrender::Scene, usize)>,
+    ) {
+        if width != 2360 || (scale - 2.0).abs() > 0.001 {
+            eprintln!(
+                "[turnstone-stage-probe] unsupported firstcapture width={width} height={height} scale={scale}"
+            );
+            return;
+        }
+        let Some((full, masks)) = captured else {
+            eprintln!(
+                "[turnstone-stage-probe] no paired paint packet; require MESQUITE_CAPTURE_PAINT=1"
+            );
+            return;
+        };
+        if masks != 0 {
+            eprintln!(
+                "[turnstone-stage-probe] unsupported shadow masks={masks}; no diagnostic rendering"
+            );
+            return;
+        }
+        let core = surface.core();
+        let before = surface.renderer().vello_live_texture_registrations();
+        let mut sampler = netrender::Scene::new(831, 328);
+        sampler.push_image_full(
+            0.0,
+            0.0,
+            831.0,
+            328.0,
+            [0.0, 0.0, 1.0, 1.0],
+            [1.0; 4],
+            CSS_IMAGE,
+            0,
+            netrender::NO_CLIP,
+        );
+        let (sample, _) = core.rasterize_scaled_for(
+            PROBE_RASTER,
+            &sampler,
+            1662,
+            656,
+            netrender::ColorLoad::Clear(wgpu::Color::TRANSPARENT),
+            2.0,
+        );
+        let after_sampler = surface.renderer().vello_live_texture_registrations();
+        let (replay, _) = core.rasterize_scaled_for(
+            PROBE_RASTER + 1,
+            &full,
+            width,
+            height,
+            netrender::ColorLoad::Clear(wgpu::Color::BLACK),
+            scale,
+        );
+        let after_replay = surface.renderer().vello_live_texture_registrations();
+        self.metadata = serde_json::json!({"original_child":parent,"css_image_key":format!("{CSS_IMAGE:#018x}"),"sampler_raster_key":format!("{PROBE_RASTER:#018x}"),"full_raster_key":format!("{:#018x}",PROBE_RASTER+1),"sampler_logical_size":[831,328],"full_viewport":[full.viewport_width,full.viewport_height],"full_ops":full.ops.len(),"full_fonts":full.fonts.len(),"box_shadow_masks":masks,"live_texture_registrations":{"before":before,"after_sampler":after_sampler,"after_replay":after_replay},"source_registry_operations":"none","original_capture_armed_first":true,"copy_order":"original child copy first; fresh sampler then fresh full packet; arm both probe copies after both rasters; collect both before raw writes"});
+        let mut copies = Vec::new();
+        for (label, texture, w, h) in [
+            ("staged-css", sample, 1662, 656),
+            ("fresh-full", replay, width, height),
+        ] {
+            let armed = Instant::now();
+            match core.start_rgba8_readback(&texture, w, h) {
+                Ok(pending) => copies.push(Copy {
+                    label,
+                    pending,
+                    armed,
+                    mapped: None,
+                    mapped_ms: None,
+                }),
+                Err(error) => {
+                    eprintln!("[turnstone-stage-probe] arm {label} failed:{error}");
+                    return;
+                }
+            }
+        }
+        self.copies = Some(copies);
+    }
+    fn poll(&mut self) {
+        let Some(mut copies) = self.copies.take() else {
+            return;
+        };
+        for copy in copies.iter_mut().rev() {
+            if copy.mapped.is_some() {
+                continue;
+            }
+            if copy.armed.elapsed() >= Duration::from_secs(5) {
+                eprintln!("[turnstone-stage-probe] {} exceeded5s", copy.label);
+                return;
+            }
+            let started = Instant::now();
+            let ready = copy.pending.poll();
+            if started.elapsed() >= Duration::from_millis(250)
+                || copy.armed.elapsed() >= Duration::from_secs(5)
+            {
+                eprintln!(
+                    "[turnstone-stage-probe] {} missednonblocking/deadline",
+                    copy.label
+                );
+                return;
+            }
+            if let Some(ready) = ready {
+                match ready {
+                    Ok(frame) => {
+                        copy.mapped_ms = Some(copy.armed.elapsed().as_millis());
+                        copy.mapped = Some(frame);
+                    }
+                    Err(error) => {
+                        eprintln!("[turnstone-stage-probe] {} mapfailed:{error}", copy.label);
+                        return;
+                    }
+                }
+            }
+        }
+        if copies.iter().any(|copy| copy.mapped.is_none()) {
+            self.copies = Some(copies);
+            return;
+        }
+        // Both copies are collected before I/O. No PNG, hashes or pixel scans
+        // run on the native event loop. Parent converts after process exit.
+        let result = (|| -> Result<(), String> {
+            use std::io::Write;
+            std::fs::create_dir_all(&self.directory).map_err(|e| e.to_string())?;
+            let mut records = Vec::new();
+            for copy in copies {
+                let frame = copy.mapped.unwrap();
+                let raw_path = self.directory.join(format!("{}.rgba", copy.label));
+                let mut raw = std::fs::OpenOptions::new()
+                    .write(true)
+                    .create_new(true)
+                    .open(&raw_path)
+                    .map_err(|e| e.to_string())?;
+                raw.write_all(&frame.rgba).map_err(|e| e.to_string())?;
+                records.push(serde_json::json!({"label":copy.label,"width":frame.width,"height":frame.height,"byte_count":frame.rgba.len(),"arm_to_map_ms":copy.mapped_ms,"raw_path":raw_path}));
+            }
+            self.metadata["copies"] = serde_json::json!(records);
+            let mut json = std::fs::OpenOptions::new()
+                .write(true)
+                .create_new(true)
+                .open(self.directory.join("staged-probe.json"))
+                .map_err(|e| e.to_string())?;
+            json.write_all(self.metadata.to_string().as_bytes())
+                .map_err(|e| e.to_string())?;
+            Ok(())
+        })();
+        match result {
+            Ok(()) => eprintln!("[turnstone-stage-probe] mapped:{}", self.metadata),
+            Err(error) => eprintln!("[turnstone-stage-probe] failed:{error}"),
+        }
+    }
+}
