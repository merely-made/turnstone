# After saving the app preference, embed.html still belongs to its host.
assert snap ready == true
assert title An embedding page
assert host {"selector":"#host-title","text":"An embedding page"}
assert snap appearance-owner == host
assert snap appearance-background == rgb(244, 239, 230)
assert host {"selector":"#search-input","attribute":"data-host-keys","value":"0"}
assert host {"selector":"#session-local","attribute":"data-host-clicks","value":"0"}
capture appearance_embedded_host
wait
log embedded appearance inherits host roles
