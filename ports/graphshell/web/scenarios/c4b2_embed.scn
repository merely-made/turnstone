# Expose retained disclosure controls; return focus to the original canvas key target.
click role:button Remote session
focus-retained .tree-canvas
# C4b.2: the embedded surface. embed.html is someone else's page — its own
# heading, its own input and button carrying the component's *unprefixed*
# id names (`search-input`, `session-local`) — with <graphshell-view> in a
# 960 x 600 box between them. The same bundle and host as the full page.
assert snap ready == true
assert snap session == local
assert snap detail-open == false
assert snap active-session ~ Local Mere
assert retained {"role":"button","label":"Local Mere","attribute":"aria-pressed","value":"true"}
# The host page is untouched by the mount: its title, its ids, its text.
assert title An embedding page
assert host {"selector":"#host-title","text":"An embedding page"}
assert host {"selector":"#search-input","attribute":"data-host-keys","value":"0"}
assert host {"selector":"#session-local","attribute":"data-host-clicks","value":"0"}
capture c4b2_embed_boot
wait
# Keys with focus on the host page's input reach the host page, not the
# component: the camera does not move, the host counts the key.
host-input focus #search-input
wait
assert host {"selector":"#search-input","focused":true}
# Historical presenter comment: The camera sits at the centre of the component's own 960 x 600 box, not
# Historical presenter comment: of the page: the component measures itself, not the viewport.
# Geometry adaptation: actual retained canvas leaf, below the header and beside docked tools.
assert snap camera-centered == true
assert snap zoom == 1
mark-camera
host-input key ArrowLeft
wait
settle 1
assert snap camera-dx == 0
assert snap camera-dy == 0
# Geometry adaptation: actual retained canvas leaf, below the header and beside docked tools.
assert snap camera-centered == true
assert snap zoom == 1
mark-camera
assert host {"selector":"#search-input","attribute":"data-host-keys","value":"1"}
# The host page's button with the component's old id is the host's own.
host-input click #session-local
wait
settle 1
assert host {"selector":"#session-local","attribute":"data-host-clicks","value":"1"}
assert snap session == local
# Keys with focus inside the component reach the component.
focus-retained .tree-canvas
assert retained {"class":"tree-canvas","focused":true}
key ArrowLeft
settle 1
# Moved left of the box's centre; the distance is velocity-shaped.
assert event command pan-left
assert snap camera-dx <= -40
assert snap camera-dy == 0
key Enter
settle 1
assert snap detail-open == true
assert retained {"class":"tree-detail","count":1,"visible":true}
key Escape
settle 1
assert snap detail-open == false
# Tab order: the component's controls take focus in document order.
focus-retained role:button Remote mount
assert retained {"role":"button","label":"Remote mount","focused":true}
key Enter
settle 1
# Historical presenter comment: Enter on a focused button is a click in a browser; a synthetic keydown is
# Historical presenter comment: not, so the session stays local and the host page still counted nothing.
# Historical presenter comment: The component's own Enter mapping opened the detail; close it, so both
# surfaces' receipts end in the same state and their semantic trees compare.
assert host {"selector":"#search-input","attribute":"data-host-keys","value":"1"}
assert host {"selector":"#session-local","attribute":"data-host-clicks","value":"1"}
key Escape
settle 1
assert snap detail-open == false
capture c4b2_embed_after
wait
log c4b2 embed receipt complete
