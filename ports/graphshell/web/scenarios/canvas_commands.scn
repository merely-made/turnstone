# Drag to pan, right-drag select and the command context menu (Scenograph
# editor plan, track C1). Coordinates are canvas pixels: the graph sits near
# the middle of a 1280-wide page, so (1000, 150) and (800, 500) are empty.
assert title GRAPHSHELL H3 READY
mark-camera
pointer down left 800 500
settle 1
pointer move left 830 515
settle 1
pointer move left 900 550
settle 1
pointer up left 900 550
settle 2
assert snap camera-dx >= 90
assert snap camera-dy >= 40
assert snap command-menu == closed
# A right-drag selects; it opens no menu.
pointer down right 520 200
settle 1
pointer move right 780 460
settle 1
pointer up right 780 460
settle 2
assert snap command-menu == closed
# A right click on empty canvas opens the menu: search, then the kept commands.
pointer down right 1000 150
settle 1
pointer up right 1000 150
settle 2
assert snap command-menu == open
assert dom #gs-command-menu-items Zoom in
assert dom #gs-command-menu-items Fit to view
type #gs-command-search tempo
settle 2
assert dom #gs-command-menu-items Projection: order by tempo
dom click [data-command-menu="keep:projection-scatter"]
settle 6
assert snap session-store == stored
key escape
settle 2
assert snap command-menu == closed
# Reopened, the kept command is in the menu without a search.
pointer down right 1000 150
settle 1
pointer up right 1000 150
settle 2
assert dom #gs-command-menu-items Projection: order by tempo
dom click [data-command-menu="run:zoom-in"]
settle 6
assert snap command-menu == closed
assert snap session-store == stored
capture canvas_commands
wait
log canvas pan, right-drag select and command menu proof complete
