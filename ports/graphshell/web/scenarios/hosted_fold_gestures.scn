# Host-page gesture routing with an entered Fold and selected member.
# grouped-dataset.html
assert snap ready == true
settle 3
click role:button Expand mere
settle 2
click role:button Enter mere workspace
settle 2
click role:button Fit visible graph
settle 2
assert snap nodes == 9
set-zoom 1
settle 2
remember plain-wheel
wheel-graph 90
settle 2
assert snap wheel-use == Some(Page)
assert snap gesture == wheel kept true
same plain-wheel zoom
same plain-wheel camera
wheel-graph -90 ctrl
settle 2
assert snap wheel-use == Some(Zoom)
assert snap gesture == wheel kept false
assert snap zoom >= 1.1
wheel-graph 90 meta
settle 2
assert snap gesture == wheel kept false
set-zoom 1
settle 2
pinch 2 30 20
settle 2
assert snap touch-use == Some(TwoFinger)
assert snap gesture == pinch prevented true
assert snap zoom >= 1.9
touch-graph 4 4
settle 2
assert snap touch-use == Some(Page)
assert snap gesture == touch withheld true prevented false
click role:button Fit visible graph
settle 2
center-node urn:host-dataset:crate:mere:sceno
settle 2
touch-node urn:host-dataset:crate:mere:sceno
settle 2
assert snap touch-use == Some(Drag)
assert snap gesture == touch withheld false prevented true
assert snap selection-fit-available == true
click role:button Fit selection
settle 2
assert snap selection-center-distance <= 1
capture folds_gestures
log hosted Fold gestures receipt complete
