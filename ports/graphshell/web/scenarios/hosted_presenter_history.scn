# tree.html?dataset=fixtures/grouped-host-history.json&grouping=contains&presenter=inspector
assert snap presenter == true
assert snap history-index == 2
reveal role:button Choose projects
click role:button Choose projects
click .presenter-select @data-occurrence-id=repo:genet
click .presenter-select @data-occurrence-id=repo:woodshed
settle 3
assert snap presenter-selected == repo:genet,repo:woodshed
assert snap canvas-selection-count == 2
remember selected-checkpoint
click role:button Earlier checkpoint
settle 3
assert snap history-index == 1
assert snap presenter-selected == repo:genet,repo:woodshed
assert snap canvas-selection-count == 2
same selected-checkpoint camera
same selected-checkpoint zoom
click role:button Later checkpoint
settle 3
assert snap history-index == 2
assert snap presenter-selected == repo:genet,repo:woodshed
assert snap canvas-selection-count == 2
same selected-checkpoint camera
same selected-checkpoint zoom
capture presenter-selection-at-checkpoint
