# First choose fixtures/tree-intake.txt through the actual Cambium file chooser.
# This independent load checks the stored content identity and emits owner facets.
assert snap source == saved graph
assert snap storage-reopened == true
click role:button Fit graph
settle 3
click-node ni:///sha-256;_P0BW5semuL1FVl1NsZhk6nmKzK0KfI1bwmCRqtALIk
settle 2
key Enter
settle 2
assert snap detail-open == true
assert snap detail-title == tree-intake.txt
assert snap detail-address == ni:///sha-256;_P0BW5semuL1FVl1NsZhk6nmKzK0KfI1bwmCRqtALIk
capture p4_tree_file_reopen
wait 120
