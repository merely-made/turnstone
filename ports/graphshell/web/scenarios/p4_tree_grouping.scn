click role:button Open codicil
settle 3
assert snap imported-nodes == 8
assert snap physics-composition == mix
assert snap role-group-source == site
assert snap panel-role-group-source == site
assert snap physics-live-spec ~ groups.site
assert snap physics-live-spec ~ s0.example
assert snap physics-live-spec ~ 0.1
assert snap physics-live-spec ~ 0.3
assert snap effective-roles ~ 00000000-0000-0000-0000-000006b10002","anchored
assert snap effective-roles ~ 00000000-0000-0000-0000-000006b10000","pinned
click role:button Panes
click role:button Graph controls
click role:button Fit graph
settle 2
click role:combobox Grouping partition
click role:option By cluster
click role:combobox Outer law
click role:option Charge
click role:textbox Outer share
input-text 0.1
click role:combobox Inner law
click role:option Springs
click role:button Apply grouping
settle 2
assert snap physics-composition == grouped
assert snap grouping-partition == groups.cluster
assert snap panel-grouping-partition == cluster
assert snap panel-grouping-outer == charge.barnes-hut
assert snap panel-grouping-inner == spring.rapier
assert snap panel-grouping-outer-share == 0.1
remember grouping_authored
assert snap physics-root-spec ~ groups.cluster
assert snap physics-root-spec ~ 0.1
# Role overrides still read Site: node 2 is Anchored and node 0 is Pinned.
assert snap role-group-source == site
assert snap panel-role-group-source == site
assert snap effective-roles ~ 00000000-0000-0000-0000-000006b10002","anchored
assert snap effective-roles ~ 00000000-0000-0000-0000-000006b10000","pinned
# Group pull uses its own source. Applying the source edit keeps the typed root.
click role:combobox Groups
click role:option By island
click role:button Apply physics
settle 2
assert snap panel-group-source == component
assert snap physics-group-source == component
assert snap grouping-partition == groups.cluster
assert snap physics-composition == grouped
assert snap role-group-source == site
assert snap physics-live-spec ~ groups.component
assert snap physics-live-spec ~ groups.site
assert snap physics-live-spec ~ groups.cluster
assert snap physics-live-spec ~ s0.example
assert snap physics-live-spec ~ 0.1
same grouping_authored physics-root-spec
# Save the typed grouping into the canonical v4 facet.
click role:button Save scene
wait 120
assert snap saved-scene-facet == v4
assert snap saved-scene-matches-live == true
assert snap saved-scene-spec ~ groups.cluster
assert snap saved-scene-spec ~ groups.component
assert snap saved-scene-spec ~ groups.site
assert snap saved-scene-spec ~ 0.1
remember grouping_saved
capture grouping_saved
# Anneal writes positions, so the grouped action refuses it atomically.
click role:combobox Outer law
click role:option Anneal
click role:button Apply grouping
settle 2
assert snap physics-composition == grouped
assert snap grouping-partition == groups.cluster
assert snap panel-status ~ Grouping refused
same grouping_saved physics-root-spec
same grouping_saved saved-scene-spec
assert snap saved-scene-matches-live == true
capture grouping_refused
# Use single law explicitly clears the grouped root; the stored record stays intact.
click role:button Use single law
settle 2
assert snap physics-composition == none
assert snap physics-root-spec ~ charge.barnes-hut
assert snap saved-scene-matches-live == false
same grouping_saved saved-scene-spec
click role:button Reopen scene
wait 120
assert snap physics-composition == grouped
assert snap grouping-partition == groups.cluster
assert snap panel-grouping-partition == cluster
assert snap panel-grouping-outer == charge.barnes-hut
assert snap panel-grouping-inner == spring.rapier
assert snap panel-grouping-outer-share == 0.1
assert snap physics-group-source == component
assert snap panel-group-source == component
assert snap role-group-source == site
assert snap panel-role-group-source == site
assert snap saved-scene-matches-live == true
same grouping_saved physics-root-spec
same grouping_saved saved-scene-root-spec
same grouping_saved saved-scene-spec
assert snap effective-roles ~ 00000000-0000-0000-0000-000006b10002","anchored
assert snap effective-roles ~ 00000000-0000-0000-0000-000006b10000","pinned
capture grouping_reopened
click role:button Save scene
wait 120
same grouping_saved saved-scene-root-spec
same grouping_saved saved-scene-spec
assert snap saved-scene-matches-live == true
log bounded grouped composition authoring and canonical v4 reopen complete
