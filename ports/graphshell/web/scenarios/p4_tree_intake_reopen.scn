# Independent browser load with p4_tree_intake's dedicated profile.
# The receipt's graph-session/detail-member must match the prior run externally.
assert snap source == saved graph
assert snap storage-reopened == true
click role:button Fit graph
settle 3
click-node https://example.net/tree-intake
settle 2
key Enter
settle 2
assert snap detail-open == true
assert snap detail-title == TreeIntakeSavedTitle
assert snap detail-tags == durable, intake
capture p4_tree_intake_reopen
wait 120
