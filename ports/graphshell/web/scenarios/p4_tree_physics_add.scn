# Tree version of physics_add.scn: the same receipt through the docked Graph tools
# panel's Cambium controls and the tree lane's observations.
# Adding a node under every law. A structural change reheats the layout
# (the new body is not left frozen where it landed), and the graph never
# ends up with bodies on top of each other. Under Still the reheat holds
# everything, the newcomer included.
assert snap ready == true
# The boot arrangement pauses the canvas; the receipt wants the law running.
click role:button Play physics
settle 1
assert snap physics-paused == false
# No arrangement: the boot Spiral's anchor springs would pull under every law.
click role:combobox Arrangement
settle 1
click role:option Free (physics alone)
settle 1
click role:button Apply arrangement
settle 1
assert snap layout == free
assert snap canvas-nodes == 11

# --- Springs ---
log add Springs
click role:combobox Physics law
settle 1
click role:option Springs
settle 1
click role:button Apply physics
settle 120
assert snap physics-law == spring.rapier
add-node 300 260 mere://p4/add/springs
settle 1
assert snap canvas-nodes == 12
settle 300
assert snap layout-overlaps == 0
assert snap physics-energy <= 500
capture physics_add_springs
settle 2

# --- Charge ---
log add Charge
click role:combobox Physics law
settle 1
click role:option Charge
settle 1
click role:button Apply physics
settle 120
assert snap physics-law == charge.barnes-hut
add-node 320 272 mere://p4/add/charge
settle 1
assert snap canvas-nodes == 13
settle 300
assert snap layout-overlaps == 0

