# Tree version of physics_drag.scn: the same receipt through the docked Graph tools
# panel's Cambium controls and the tree lane's observations.
# Drag under every law. The fixture's web node is selected, pressed, moved
# 220px right and released; `drag-return` is how far the law has since
# carried it off the drop point. A law that rests reclaims the node, a
# restless law keeps moving, Still holds it where it was let go.
assert snap ready == true
# The boot arrangement pauses the canvas; the receipt wants the law running.
click role:button Play physics
settle 1
assert snap physics-paused == false
# No arrangement: the boot Spiral's anchor springs would pull under every law.
click role:combobox Arrangement
settle 1
click role:option Free (physics alone)
settle 1
click role:button Apply arrangement
settle 1
assert snap layout == free

# --- Springs ---
log drag Springs
click role:combobox Physics law
settle 1
click role:option Springs
settle 1
click role:button Apply physics
settle 120
# A law can carry the node out of view; a real pointer needs it on screen.
center-node https://example.test/i2p-port
settle 1
click-node https://example.test/i2p-port
settle 1
assert snap physics-law == spring.rapier
press-focused
settle 1
# The press took hold of a node (a member id, so it carries a dash).
assert snap dragging-node ~ -
move-by 220 0
settle 1
release-at
settle 1
assert snap drag-return <= 20
settle 300
assert snap drag-return >= 40
assert snap layout-overlaps == 0
capture physics_drag_springs_reclaimed
settle 2

