# Tree version of physics_springs.scn: the same receipt through the docked Graph tools
# panel's Cambium controls and the tree lane's observations.
# Springs, the force-directed default: rest, no overlaps, the energy gone.
assert snap ready == true
# The boot arrangement pauses the canvas; the receipt wants the law running.
click role:button Play physics
settle 1
assert snap physics-paused == false
# No arrangement: the boot Spiral's anchor springs would pull under every law.
click role:combobox Arrangement
settle 1
click role:option Free (physics alone)
settle 1
click role:button Apply arrangement
settle 1
assert snap layout == free
click role:combobox Physics law
settle 1
click role:option Springs
settle 1
click role:button Apply physics
settle 1
assert snap physics-law == spring.rapier
assert snap physics-profile == law.springs
assert snap panel-profile == law.springs
assert text Physics set to Springs
capture physics_springs_start
settle 2
settle 60
capture physics_springs_settled
# Framing (2026-10-03): every node's centre on the visible canvas at the
# frame this capture shows, read from the canvas's positions and camera.
assert snap layout-outside == 0
settle 2
# The ring-down gone, nothing overlapping, the graph not flying apart.
settle 300
assert snap physics-energy <= 500
assert snap layout-overlaps == 0
assert snap layout-spread <= 250
# Framing after the settle.
assert snap layout-outside == 0
log physics springs receipt complete
