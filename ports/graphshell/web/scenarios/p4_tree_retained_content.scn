# Explicit fixture=retained-content; real Fleece admission and Pelt/Genet owners.
assert snap source == saved graph
click-node https://retained.example/notes
settle 1
click role:button Open selected in workbench
wait 1000
assert snap pelt-sessions >= 1
assert snap pelt-pending == false
capture pelt_native_held_html
click role:button Return to Mere
settle 2
click-node mere://clip/b40c579d5234ed1f14d7512474a18c958c5e07f1a16f27afc42d337eeabd07ba
settle 1
click role:button Open selected in workbench
wait 1000
assert snap pelt-sessions >= 2
assert snap pelt-pending == false
capture pelt_fleece_selected_text
click role:button Return to Mere
settle 2
click-node mere://clip/9cb36d1a9fc01a661d1d1941fad00fb10faf077829b229ea896c9e59e0262e29
settle 1
click role:button Open selected in workbench
wait 1000
assert snap pelt-sessions == 3
assert snap pelt-pending == false
assert snap pelt-producers == 3
capture pelt_retained_voice_controls
