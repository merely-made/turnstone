click role:button Open codicil
settle 3
assert snap imported-nodes == 8
assert snap physics-composition == mix
assert snap role-group-source == site
assert snap panel-role-group-source == site
assert snap physics-live-spec ~ groups.site
assert snap physics-live-spec ~ s0.example
assert snap physics-live-spec ~ 0.1
assert snap physics-live-spec ~ 0.3
# Site roles prove item-over-group: node 0 is Pinned; its same-site peer 2 is Anchored.
assert snap effective-roles ~ 00000000-0000-0000-0000-000006b10000","pinned
assert snap effective-roles ~ 00000000-0000-0000-0000-000006b10002","anchored
assert snap effective-roles ~ 00000000-0000-0000-0000-000006b10001","seeded
click role:button Panes
click role:button Graph controls
click role:button Fit graph
settle 2
remember role-source-site
capture role_groups_fixture_open
wait
# Switching the group source makes s0.example unmatched, so the Seeded default applies.
click role:combobox Role groups
click role:option By cluster
click role:button Apply role groups
settle 2
assert snap role-group-source == cluster
assert snap panel-role-group-source == cluster
assert snap effective-roles ~ 00000000-0000-0000-0000-000006b10000","pinned
assert snap effective-roles ~ 00000000-0000-0000-0000-000006b10002","seeded
capture role_groups_cluster_fallback
wait
# The explicit item override remains Pinned through both group-source readings.
click role:combobox Role
click role:option Anchored
click role:button Apply role
settle 2
assert snap arrangement-role == anchored
same role-source-site physics-root-spec
assert snap effective-roles ~ 00000000-0000-0000-0000-000006b10002","anchored
assert snap effective-roles ~ 00000000-0000-0000-0000-000006b10000","pinned
# Group pull uses a separate source from the role-target map.
click role:combobox Groups
click role:option By island
click role:button Apply physics
settle 2
assert snap panel-group-source == component
assert snap role-group-source == cluster
assert snap physics-composition == mix
same role-source-site physics-root-spec
assert snap physics-live-spec ~ groups.component
assert snap physics-live-spec ~ groups.cluster
# Save while Cluster is selected, then change the live picker before reopening.
click role:button Save scene
wait 120
assert snap saved-scene-facet == v4
assert snap saved-scene-matches-live == true
assert snap saved-scene-spec ~ groups.cluster
assert snap saved-scene-spec ~ s0.example
assert snap saved-scene-spec ~ 0.1
assert snap saved-scene-spec ~ 0.3
remember role-target-cluster-saved
capture role_groups_cluster_saved
wait
click role:combobox Role groups
click role:option By site
click role:button Apply role groups
settle 2
assert snap role-group-source == site
assert snap panel-role-group-source == site
assert snap effective-roles ~ 00000000-0000-0000-0000-000006b10002","anchored
assert snap effective-roles ~ 00000000-0000-0000-0000-000006b10000","pinned
click role:button Reopen scene
wait 120
assert snap role-group-source == cluster
assert snap panel-role-group-source == cluster
assert snap panel-group-source == component
assert snap arrangement-role == anchored
assert snap physics-composition == mix
assert snap saved-scene-matches-live == true
assert snap effective-roles ~ 00000000-0000-0000-0000-000006b10002","anchored
assert snap effective-roles ~ 00000000-0000-0000-0000-000006b10000","pinned
same role-target-cluster-saved physics-live-spec
same role-target-cluster-saved saved-scene-spec
reveal role:combobox Groups
settle 2
capture role_groups_reopened
# Re-save the reopened v4 record and require byte-identical dynamics.
click role:button Save scene
wait 120
same role-target-cluster-saved saved-scene-spec
assert snap saved-scene-matches-live == true
log role groups source, precedence, and canonical v4 reopen complete
