node":"preset","id":"spring.rapier","weight":0.1},{"node":"preset","id":"charge.barnes-hut","weight":0.3}]},"seed":104375397257316,"target":{"arrangement":"grid.default","anchored_pull":12.0,"default_role":"seeded","groups":{"channel":"groups.site","roles":{"s0.example":"anchored"}},"items":{"00000000-0000-0000-0000-000006b10000":"pinned"}},"version":1},"camera_offset":[0.0,0.0],"camera_zoom":1.0,"default_handler":"system.default","cartography":{"positions":[],"sizes":[],"size_by_degree":false,"size_by_importance":false,"importance_metric":"","sprites":[],"sprite_hulls":[],"materials":[],"faces":[]}}}
click role:button Open codicil
settle 3
assert snap imported-nodes == 8
settle 2
click role:button Panes
click role:button Graph controls
# Author a two-stage schedule with a shared Centre overlay. The first stage
# has a long frame budget so the recipe remains at stage zero for this read.
click role:combobox First stage law
click role:option Springs
click role:combobox First stage stop
click role:option Frames
click role:textbox First stage frames
input-text 12000
click role:combobox First stage capture
click role:option No capture
click role:combobox Second stage law
click role:option Charge
click role:combobox Second stage stop
click role:option Frames
click role:textbox Second stage frames
input-text 12000
click role:combobox Second stage capture
click role:option No capture
click role:checkbox Schedule Centre
click role:button Apply and run schedule
settle 2
assert snap actual-schedule-stage == 0
assert snap panel-schedule-first-law == spring.rapier
assert snap panel-schedule-first-stop == Frames
assert snap panel-schedule-first-frames == 12000
assert snap panel-schedule-first-capture == none
assert snap panel-schedule-second-law == charge.barnes-hut
assert snap panel-schedule-second-stop == Frames
assert snap panel-schedule-second-frames == 12000
assert snap panel-schedule-second-capture == none
assert snap panel-schedule-overlays == gravity-locus
assert snap physics-live-spec ~ schedule
assert snap physics-live-spec ~ gravity-locus
# Paused source and role edits preserve the authored recipe and active stage.
click role:button Pause physics
assert snap physics-paused == true
click role:combobox Groups
click role:option By island
click role:button Apply physics
settle 2
assert snap actual-schedule-stage == 0
assert snap physics-paused == true
assert snap physics-live-spec ~ schedule
assert snap physics-live-spec ~ groups.component
click role:combobox Role
click role:option Pinned
click role:button Apply role
settle 2
assert snap actual-schedule-stage == 0
assert snap physics-paused == true
# Save the live v4 recipe, including the target maps carried by the fixture.
click role:button Save scene
wait 120
assert snap saved-scene-facet == v4
assert snap saved-scene-matches-live == true
assert snap saved-scene-spec ~ schedule
assert snap saved-scene-spec ~ gravity-locus
assert snap saved-scene-spec ~ groups.component
assert snap saved-scene-spec ~ groups.site
assert snap saved-scene-spec ~ s0.example
assert snap saved-scene-spec ~ pinned
remember saved-schedule
capture schedule_saved
# Density refuses the shared Group pull overlay. This bad draft must leave
# both the current schedule and the exact saved facet intact.
click role:combobox Second stage law
click role:option Density
click role:checkbox Schedule Centre
click role:checkbox Schedule Group pull
click role:button Apply and run schedule
settle 2
assert snap panel-status ~ Schedule refused
assert snap panel-status ~ Density
same saved-schedule physics-root-spec
same saved-schedule saved-scene-spec
assert snap saved-scene-matches-live == true
# A single-law replacement explicitly clears the schedule, then scene reopen
# reconstructs the schedule recipe from its canonical v4 facet.
click role:button Use single law
settle 2
assert snap physics-composition == none
assert snap actual-schedule-stage == none
click role:button Reopen scene
wait 120
assert snap actual-schedule-stage == 0
assert snap physics-paused == true
assert snap panel-schedule-first-law == spring.rapier
assert snap panel-schedule-first-stop == Frames
assert snap panel-schedule-first-frames == 12000
assert snap panel-schedule-first-capture == none
assert snap panel-schedule-second-law == charge.barnes-hut
assert snap panel-schedule-second-stop == Frames
assert snap panel-schedule-second-frames == 12000
assert snap panel-schedule-second-capture == none
assert snap panel-schedule-overlays == gravity-locus
assert snap saved-scene-matches-live == true
same saved-schedule physics-live-spec
same saved-schedule saved-scene-spec
click role:button Save scene
wait 120
same saved-schedule saved-scene-spec
assert snap saved-scene-matches-live == true
log bounded two-stage schedule authoring and canonical v4 reopen complete
