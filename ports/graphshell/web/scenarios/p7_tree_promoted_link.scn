# Dedicated Graphshell promotion fixture. Follow with the fresh-page reopen scenario.
# tree.html?app=local&fixture=promoted-link&scenario=scenarios/p7_tree_promoted_link.scn
click role:button Fit graph
settle 2
assert snap storage-reopened == false
assert snap link-rest-ready == true
assert snap link-rest-source-assertion-ids ~ fixture:p7:collection-primary
assert snap link-rest-source-assertion-ids ~ fixture:p7:collection-independent
assert snap promoted-link-count == 0
remember p7-source
capture p7_source_before_promotion

# Select the source through the ordinary canvas stroke and freeze its Surface link.
click-link-rest a1-b1 surface
settle 2
assert snap link-inspector-open == true
assert text Primary collection membership
assert text Independent collection membership
reveal role:button Freeze Surface link for review
click role:button Freeze Surface link for review
settle 120
assert snap promoted-link-count == 1
assert snap promoted-link-write-status ~ saved and readable
assert snap promoted-link-drift == unchanged
assert snap promoted-link-frozen-assertion-ids == fixture:p7:collection-independent|fixture:p7:collection-primary
assert snap promoted-link-frozen-withdrawn-count == 0
same p7-source link-rest-source-facts
reveal .promoted-link-current
capture p7_link_promoted

# A permitted exact source withdrawal changes the live link, leaving the copied
# assertion and its basis unchanged on the promoted Resource.
click-link-rest-assertion fixture:p7:collection-primary withdraw
settle 120
assert snap link-rest-surface-strength == 1
assert snap promoted-link-drift == changed
assert snap promoted-link-withdrawn-ids == fixture:p7:collection-primary
assert snap promoted-link-frozen-assertion-ids == fixture:p7:collection-independent|fixture:p7:collection-primary
assert snap promoted-link-frozen-withdrawn-count == 0
# The pair inspector includes the remaining Surface reason and Resource control.
assert snap link-inspector-statements == 2
remember p7-after-withdrawal
reveal .promoted-link-current
capture p7_live_link_drifted

# The promoted Resource remains reachable from Graph tools after closing the live inspector.
click role:button Close link inspection
settle 2
reveal role:button Open promoted link 1
click role:button Open promoted link 1
settle 2
assert text Review Resource
assert text fixture:p7:collection-primary
assert text fixture:p7:collection-independent
assert snap promoted-link-drift == changed
assert snap promoted-link-withdrawn-ids == fixture:p7:collection-primary

reveal role:textbox Review comment
click role:textbox Review comment
input-text Reviewed after the source assertion was withdrawn.
reveal role:button Add review comment
click role:button Add review comment
settle 120
assert snap promoted-link-comment-count == 1
assert snap promoted-link-comment-texts == Reviewed after the source assertion was withdrawn.
same p7-after-withdrawal link-rest-source-facts
assert snap promoted-link-drift == changed
reveal .promoted-link-review-comment
capture p7_promoted_link_review_comment
log Graphshell promotion retained the frozen copy across source withdrawal and attached review to the unique Resource
