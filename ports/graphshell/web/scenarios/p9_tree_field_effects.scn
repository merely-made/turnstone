assert snap field-inspection-fixture == true
assert snap physics-paused == true
click role:button Panes
settle 2
click role:button Graph controls
settle 2
click role:button Restore arrangement
settle 3
click-node file:///Graphshell/reference-notes.md
settle 2
click role:button Inspector
settle 2
reveal role:button Explain selected dynamics
click role:button Explain selected dynamics
settle 2
