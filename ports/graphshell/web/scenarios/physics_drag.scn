# --- Orbit ---
log drag Orbit
click role:combobox Physics law
settle 1
click role:option Orbit
settle 1
click role:button Apply physics
settle 120
act select-web
settle 1
assert snap physics-law == orbit.gravity
press-focused
settle 1
# The press took hold of a node (a member id, so it carries a dash).
assert snap dragging-node ~ -
move-by-world 220 0
settle 1
release-at
settle 1
# A moving law carries the node within the release frame itself.
assert snap drag-return-world <= 60
settle 120
assert snap physics-energy >= 1

