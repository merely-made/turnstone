# --- Anneal ---
log drag Anneal
click role:combobox Physics law
settle 1
click role:option Anneal
settle 1
click role:button Apply physics
settle 120
act select-web
settle 1
assert snap physics-law == anneal.davidson-harel
press-focused
settle 1
# The press took hold of a node (a member id, so it carries a dash).
assert snap dragging-node ~ -
move-by-world 220 0
settle 1
release-at
settle 1
# A moving law carries the node within the release frame itself.
assert snap drag-return-world <= 60
# Anneal is a search that cools: it does not hold a steady energy, so what it
# owes is displacement — the node is not where the drag left it.
settle 300
assert snap drag-return-world >= 40
assert snap layout-overlaps == 0

# --- Still ---
log drag Still
click role:combobox Physics law
settle 1
