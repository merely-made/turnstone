settle 1
click role:button Apply physics
settle 120
act select-web
settle 1
assert snap physics-law == still.default
press-focused
settle 1
# The press took hold of a node (a member id, so it carries a dash).
assert snap dragging-node ~ -
move-by-world 220 0
settle 1
release-at
settle 1
assert snap drag-return-world <= 20
settle 300
assert snap drag-return-world <= 5
assert snap physics-energy <= 1
capture physics_drag_still_held
wait
log physics drag receipt complete
