# Real Rust reducer, grammar, Cambium/Genet pixels and browser storage.
assert snap practice-view == relations
click role:button @data-practice-command=motion
settle 2
assert snap practice-motion == false
click role:button @data-practice-command=select:card:2
settle 2
assert snap practice-selection == card:2
click role:button @data-practice-command=compare
settle 2
assert snap practice-view == compare
assert snap practice-selection == card:2
capture practice_compare
wait
click role:button @data-practice-command=save
settle 2
assert snap practice-saved == true
click role:button @data-practice-command=tone:C
settle 2
assert snap practice-selection == comparison
assert snap practice-saved == false
click role:button @data-practice-command=history
settle 2
assert snap practice-view == history
capture practice_history
wait
click role:button @data-practice-command=return:1
settle 2
assert snap practice-view == relations
assert snap practice-selection == card:2
click role:button @data-practice-command=reopen
settle 2
assert snap practice-view == compare
assert snap practice-selection == card:2
assert snap practice-saved == true
click role:button @data-practice-command=relations
settle 2
click role:button @data-practice-command=scatter
settle 2
assert snap practice-layout == scatter.default
assert snap practice-selection == card:2
click role:button @data-practice-command=save
settle 2
capture practice_saved
wait
log workspace views selection history recipe and persistence complete
