# Run in a NEW page load after projection_session.scn, on the same origin:
# the last stored save comes back from IndexedDB through the session.
assert title GRAPHSHELL H3 READY
act open-projection-editor
settle 2
act reload-projection
settle 2
assert retained {"role":"status","label":"Projection status","text":"Reloaded \u00b7 graphshell-reference"}
assert retained {"role":"status","label":"Projection preview","text":"Stored two \u00b7"}
assert retained {"role":"status","label":"Projection saved state","text":"No unsaved changes"}
log projection session fresh-page reload complete
