# Expose retained disclosure controls; return focus to the original canvas key target.
click role:button Scenes and transfers
focus-retained .tree-canvas
# Save and reopen a scene on the old page (dynamics grammar plan, G4b1,
# F142, F161): the save writes a version-4 scene, its dynamics spec the only
# physics and arrangement record, and a reopen brings back the arrangement,
# the law, its overlay, the sources and the recipe's role after each was
# changed away.
assert title GRAPHSHELL H3 READY
assert snap ready == true
act select-web
settle 1
click role:combobox Arrangement
settle 1
click role:option Grid
settle 1
click role:button Apply arrangement
settle 1
assert snap layout == grid.default
click role:combobox Physics law
settle 1
click role:option Stress
settle 1
check-role Grid on
click role:combobox Mass
settle 1
click role:option By rank
settle 1
click role:combobox Depth
settle 1
click role:option By layer
settle 1
click role:button Apply physics
settle 1
assert snap physics-law == stress.kamada-kawai
assert snap physics-overlays == grid-snap
assert snap physics-profile == crystal
assert snap physics-mass-source == pagerank
assert snap physics-depth-source == layers
click role:combobox Role
settle 1
click role:option Anchored
settle 1
click role:button Apply role
settle 1
assert snap arrangement-role == anchored
click role:button Save scene
settle 2
assert retained {"role":"status","label":"Graph status","text":"Scene saved"}
assert snap saved-scene-facet == v4
capture scene_save_saved
wait
# Everything changed away.
click role:combobox Arrangement
settle 1
click role:option Spiral
settle 1
click role:button Apply arrangement
settle 1
click role:combobox Physics law
settle 1
click role:option Charge
settle 1
check-role Grid off
click role:combobox Mass
settle 1
click role:option By degree
settle 1
click role:combobox Depth
settle 1
click role:option From roots
settle 1
click role:button Apply physics
settle 1
click role:combobox Role
settle 1
click role:option Seeded
settle 1
click role:button Apply role
settle 1
assert snap layout == phyllotaxis.default
assert snap physics-law == charge.barnes-hut
assert snap physics-profile == gas
assert snap physics-mass-source == degree
assert snap arrangement-role == seeded
# The reopen brings each back from the spec.
click role:button Reopen scene
settle 2
assert retained {"role":"status","label":"Graph status","text":"Saved scene reopened"}
assert snap saved-scene-facet == v4
assert snap layout == grid.default
assert snap physics-law == stress.kamada-kawai
assert snap physics-overlays == grid-snap
assert snap physics-profile == crystal
assert snap physics-mass-source == pagerank
assert snap physics-depth-source == layers
assert snap arrangement-role == anchored
assert snap physics-composition == none
capture scene_save_reopened
log scene save and reopen receipt complete
