# B2 direct shared Weld adapter on the Turnstone host device.
# Serve scenarios/fixtures/browser_scry on loopback and use the existing CEF
# runtime. Two pages must remain distinct; Workbench A owns find and zoom while
# the graph selection stays on B. Requested zoom is checked because effective
# native zoom readback is partial. Every owned paint must retain its custody.
settle 30
key escape
open ${SCRY_FIXTURE_BASE}/page-a.html
settle 80
assert focused /page-a.html
# Publish the Workbench's active member before the follower Inspector opens.
# Its target can differ from the shell address and process-wide graph cursor.
act Open node in Workbench
settle 80
assert wb-cells == 1
act Open Inspector pane
settle 10
assert row URL: ${SCRY_FIXTURE_BASE}/page-a.html
assert text ${SCRY_FIXTURE_BASE}/page-a.html
click surface:inspector .radio @data-engine-id=weld.chromium
settle 160
assert row URL: ${SCRY_FIXTURE_BASE}/page-a.html
assert row Viewer: weld.chromium
assert snap focused ~ Scry A | text= | clicks=0 | stored=
act Close pane
settle 10
# Closing Inspector clears active_pane. Re-activate the existing live tile so
# later maximize/divider actions have a Workbench owner.
act Open node in Workbench
settle 10
assert content-live
assert wb-cells == 1
assert wb-cell Scry A
assert snap host-surface-producers == 1

open ${SCRY_FIXTURE_BASE}/page-b.html
settle 80
assert focused /page-b.html
act Open node in Workbench
settle 80
assert wb-cells == 2
act Open Inspector pane
settle 10
assert row URL: ${SCRY_FIXTURE_BASE}/page-b.html
assert text ${SCRY_FIXTURE_BASE}/page-b.html
capture 00_b_inspector_before_pin
click surface:inspector .radio @data-engine-id=weld.chromium
settle 160
capture 00_b_inspector_after_pin
assert row URL: ${SCRY_FIXTURE_BASE}/page-b.html
assert row Viewer: weld.chromium
assert snap focused ~ Scry B | text= | clicks=0 | stored=
act Close pane
settle 10
act Open node in Workbench
settle 10
assert content-live
assert wb-cells == 2
assert wb-cell Scry A
assert wb-cell Scry B
assert surface content
assert snap host-surface-producers == 2
act Maximize pane
settle 40
assert maximized
capture 01_two_weld_pages
record-idle two-pages
click-at 240 120
type alpha
click-at 150 162
settle 40
assert snap browser-current ~ text=alpha
assert snap browser-current ~ clicks=1
click-at 755 120
type bravo
click-at 665 162
settle 40
assert snap browser-current ~ text=bravo
assert snap browser-current ~ clicks=1
capture 01b_independent_weld_input
click surface:workbench .tab Scry A
settle 20
click-at 180 80
settle 20
assert snap browser-current ~ /page-a.html
assert snap browser-current-content == live
assert snap browser-find-capability == supported
assert snap browser-zoom-capability ~ partial
key ctrl+f
type Page A text
settle 80
assert snap document-find-query == Page A text
assert snap document-find-count == 1
capture 02_find
key escape
act Zoom in
settle 80
assert snap browser-page-zoom-requested == 110
assert snap browser-current ~ viewport=463x518@1.1
capture 03_zoom
act Reset zoom
settle 60
assert snap browser-page-zoom-requested == 100
act Toggle live content
settle 80
assert snap host-surface-producers == 1
click surface:workbench .tab Scry B
settle 20
click-at 700 80
settle 20
assert snap browser-current ~ /page-b.html
act Toggle live content
settle 80
assert snap host-surface-producers == 0
capture 04_teardown
log B2 direct Weld: two producers, find, requested zoom and zero-resource teardown
