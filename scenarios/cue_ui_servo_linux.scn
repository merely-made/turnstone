# The real engine picker installs Servo in the product pool on hardware Vulkan and native Wayland.
settle 15
key escape
open ${SERVO_FIXTURE_BASE}/browser_servo/page-a.html
wait 240
act Open node in Workbench
wait 240
act Open Inspector pane
settle 15
click surface:inspector role:button Change viewer
settle 5
click-row graft.servo
settle 25
assert row Viewer: graft.servo
assert snap browser-current-engine == graft.servo
assert snap browser-current-content == live
assert snap host-servo-views == 1
assert snap host-cue-frames >= 1
assert row Platform: linux
assert row Presentation: NativeFrame
assert row NativeKeyboard: unavailable
assert row Ime: unavailable
click surface:inspector role:button Change viewer
settle 5
record-idle 01_servo_inspector
capture 01_servo_inspector
act Close pane
settle 20
act Open node in Workbench
settle 20
assert wb-cells == 1
record-idle 02_servo_primary
capture 02_servo_primary

# Coordinates belong to this fixed 1024x600 fixture: content begins at y=100.
# A composed checkpoint returns to the native event loop; legacy wait-row is
# scoped to OPEN panes and cannot observe this page after Inspect closes.
click-at 200 215
assert focus content
assert snap frame-focus-slot == none
capture 02a_field_focused
type alpha
settle 15
capture 02a_alpha
assert snap browser-current ~ Servo A | text=alpha | clicks=0
key backspace
settle 15
capture 02a_deleted
assert snap browser-current ~ Servo A | text=alph | clicks=0
type a
settle 15
capture 02a_edited
assert snap browser-current ~ Servo A | text=alpha | clicks=0
click-at 200 285
settle 25
capture 02b_input_navigation
assert snap browser-current ~ result.html?page=A&text=alpha&clicks=1
assert snap browser-current ~ Servo A | result=alpha | clicks=1
record-idle 02b_input_navigation
act Reload
settle 20
capture 02b_reloaded
assert snap browser-current ~ Servo A | result=alpha | clicks=1
act Back
settle 20
capture 02b_back
assert snap browser-current ~ /page-a.html
act Forward
settle 20
capture 02b_forward
assert snap browser-current ~ Servo A | result=alpha | clicks=1
act Zoom in
settle 15
capture 02c_controls
assert snap page-zoom-requested == 110
assert snap page-zoom-applied == 110
record-idle 02c_controls
act Float pane
settle 5
act Tear out pane
settle 5
act Dock pane
settle 20
assert windows == 2
assert lens-surface content
assert snap host-cue-frames >= 1
record-idle 03_servo_lens
capture-lens 03_servo_lens
act Float pane
settle 5
act Return pane to primary
settle 10
assert pane workbench
act Dock pane
settle 20
assert surface content
assert snap host-servo-views == 1
record-idle 04_servo_docked
capture 04_servo_docked
act Toggle live content
settle 30
assert snap host-servo-views == 0
act Toggle live content
settle 25
assert snap browser-current-engine == graft.servo
assert snap host-servo-views == 1
assert snap host-cue-frames >= 1
record-idle 05_servo_reopened
capture 05_servo_reopened
log Real Turnstone Servo Cue primary/lens/return/reopen receiving complete
