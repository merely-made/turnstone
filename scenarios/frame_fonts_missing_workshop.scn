# Separate fresh private profile; intentionally unavailable named family.
settle 4
click role:textbox @data-field=name
input-text TurnstoneMissingFont
click role:button @data-font-role=interface
click role:textbox @data-field=font-family
input-text Turnstone Intentionally Absent 20261013
click role:textbox @data-field=font-size
input-text 38
click role:button @data-action=apply-fonts
click role:button @data-action=save
settle 3
assert snap dirty == false
