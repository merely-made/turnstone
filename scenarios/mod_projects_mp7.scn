# Mod projects MP7 receipt: a parser project and a viewer project pass their
# fixtures and install from the section, then pages of the parser's declared
# media types open in Turnstone parsed by the mod: a page, a page the mod
# refuses, and a page that makes it trap (an error page naming the mod).
# Serve the pages with their media types first:
#   python scenarios/fixtures/mod_parsers/serve.py 43119
# FRESH profile (TURNSTONE_ROOT, the data root). TURNSTONE_MOD_FIXTURES names
# tests/fixtures/mod-projects (parser-notes/ and viewer-nodes/, read only).
settle 30
key escape

mod-create ${TURNSTONE_MOD_FIXTURES}/parser-notes
assert event mod-create notes-parser ok
mod-create ${TURNSTONE_MOD_FIXTURES}/viewer-nodes
assert event mod-create nodes-viewer ok
mod-check notes-parser
assert event mod-check notes-parser ok
mod-check nodes-viewer
assert event mod-check nodes-viewer ok
mod-fixtures notes-parser
assert event mod-fixtures notes-parser ok: 2 of 2 fixtures passed
mod-fixtures nodes-viewer
assert event mod-fixtures nodes-viewer ok: 1 of 1 fixtures passed
# A page of the parser's declared media type opens parsed by the mod.
open http://127.0.0.1:43119/field.notes
settle 80
act Toggle live content
settle 100
assert content-live
capture 02_page_parsed_by_the_mod

# The inspector says which parser made the page.
act Open Inspector pane
settle 10
act Maximize pane
settle 10
assert row parsed by mod Notes parser
capture 02b_inspector_top
scroll 500 400 700
settle 10
capture 02c_inspector_names_the_parser
act Maximize pane
settle 10
act Close pane
settle 20

# The refused page: an error page naming the mod and why.
open http://127.0.0.1:43119/no.refuse
settle 80
act Toggle live content
settle 100
capture 03_refusal_names_the_mod
scroll 700 400 400
settle 10
capture 03b_refusal_reason

# The trapping page: the same, and the instance is dropped.
open http://127.0.0.1:43119/bad.trap
settle 80
act Toggle live content
settle 100
capture 04_trap_names_the_mod
scroll 700 400 400
settle 10
capture 04b_trap_reason

# The next page attaches a fresh instance and parses again.
open http://127.0.0.1:43119/again.notes
settle 80
act Toggle live content
settle 100
assert content-live
capture 05_next_page_parses_after_the_trap

# The section: the viewer and the parser rows, installed, the parser's last
# trap kept.
act id:pane:settings
scroll 760 400 -3000
settle 10
capture 06a_viewer_row_installed
scroll 760 400 300
settle 10
capture 06b_after_the_viewer_row
scroll 760 400 300
settle 10
capture 06c_parser_row_kind_and_media_types
scroll 760 400 300
settle 10
capture 06d_parser_row_check_and_trap
scroll 760 400 300
settle 10
capture 06e_parser_row_trap_kept
