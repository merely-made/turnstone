# T5a founder path (design_docs/2026-07-28_turnstone_place_port_plan.md,
# "T5a. Founder path and two-window proof"). Founds a place, exports a card,
# invites the joiner's offered pre-key, and exchanges one message each way.
# Runs paired with scenarios/place_joiner.scn through a shared exchange
# directory named by ${EXCHANGE} (set by scenarios/place_two_windows.ps1,
# which also isolates LOCALAPPDATA/TURNSTONE_ROOT/PERSONAE_PROFILE per role).
settle 30
key escape

act Found place
settle 5
assert omnibar open
type Demo
key enter
settle 10
assert omnibar closed

# `join_live` opens listen-only with no peers dialed yet; the founder's own
# transport ticket appears as a "Local rendezvous: <ticket>" status line
# (src/place.rs status_lines) once the bind completes.
wait-status 300 Local rendezvous

act Export place card
settle 5
type ${EXCHANGE}\demo.place-card.json
key enter
settle 10
wait-file 600 ${EXCHANGE}\demo.place-card.json

# The joiner offers a pre-key against the card (place_joiner.scn); wait for
# its file in the exchange directory before inviting it.
wait-file 3000 ${EXCHANGE}\demo.place-card.json.prekey.json

act Invite to place
settle 5
type ${EXCHANGE}\demo.place-card.json.prekey.json
key enter
settle 10
wait-file 600 ${EXCHANGE}\demo.place-card.json.prekey.json.invite.json

act Send place message
settle 5
type hello from founder
key enter
settle 10

# Message bodies are not status facts; the retained-history count is. One
# message is the founder's own, two means the joiner's reply arrived and was
# folded through resync after the lane watcher's nudge.
wait-status 3000 Retained history: 0 shared nodes, 2 messages

act Place status
settle 10
capture founder_status
record-place founder_phase1

# Step 6 (T5a scope): stop one process, author while it is absent, restart,
# converge. The driver kills the joiner and signals it here; the founder
# keeps running the whole time (one long founder scenario spans both phases).
wait-file 6000 ${EXCHANGE}\joiner.stopped

act Send place message
settle 5
type while you were away
key enter
settle 10
wait-status 3000 Retained history: 0 shared nodes, 3 messages

record-place founder_absent_authored

# The returning joiner reconnects offline, converges the absent-authored
# message, then sends one more; wait for its marker before going on.
wait-file 6000 ${EXCHANGE}\joiner.returned
wait-status 3000 Retained history: 0 shared nodes, 4 messages

# T5b step 7 setup: a second card for the reader (its pre-key offer lands
# beside the card, so the joiner's files are never overwritten), then an
# invitation that admits at Read with no delegation.
act Export place card
settle 5
type ${EXCHANGE}\demo-reader.place-card.json
key enter
settle 10
wait-file 600 ${EXCHANGE}\demo-reader.place-card.json
wait-file 6000 ${EXCHANGE}\demo-reader.place-card.json.prekey.json

act Invite to place as reader
settle 5
type ${EXCHANGE}\demo-reader.place-card.json.prekey.json
key enter
settle 10
wait-file 600 ${EXCHANGE}\demo-reader.place-card.json.prekey.json.invite.json

# T5b step 4: open one page written by the driver and share the focused node
# into the shared graph. The returning joiner and the reader each wait for
# "1 shared nodes" and open the same address.
open ${EXCHANGE_URL}/shared.html
settle 20
# Live content is per node and off until asked for; a presented Reader in the
# workbench is the "live web surface" the reframe's step 4 names.
act Toggle live content
settle 30
assert content-ready
assert content-live
act Open node in Workbench
settle 30
assert pane workbench
assert surface content
capture founder_shared
act Share focused node
wait-status 600 Retained history: 1 shared nodes

# T5b step 7: the reader attempts to share its own focused node and its own
# worker refuses before anything is authored. The witness is the shared
# graph, not the local canvas: after the reader reports finished, a fresh
# status refresh still retains exactly one shared node, and that resync would
# have folded any operation that had actually left the reader.
wait-file 6000 ${EXCHANGE}\reader.finished
act Place status
settle 30
key escape
wait-status 60 Retained history: 1 shared nodes

# Reading (mere design_docs/mere_docs/implementation_strategy/2026-09-16_
# coop_lifecycle_parity_plan.md, R2): one message sent after the reader
# joined, so its add frame travelled the group-key lane first. The returning
# joiner waits for it below as its fifth retained message.
act Send place message
settle 5
type after the reader joined
key enter
settle 10
wait-status 3000 Retained history: 1 shared nodes, 5 messages

# T5c: shared Knot document by projection (design_docs/2026-07-28_turnstone_
# place_port_plan.md, "T5c. Shared Knot document by projection"). Placed
# AFTER the reader's refused-write receipt above (not before wait-file
# reader.finished) so the reader's own "exactly 1 shared node" checks are
# never disturbed by sharing a second (Knot) node. ${FOUNDER_VAULT_URL} names
# this founder's own Knot vault directory (set by scenarios/
# place_two_windows.ps1, which also points TURNSTONE_KNOT_ROOT at it for
# this process only).
open ${FOUNDER_VAULT_URL}/field.knot
settle 20
act Toggle live content
wait
assert content-live
# Present it in the Workbench, the same as the T5b HTML page above: opening
# an address alone does not make it an addressable, click-routable content
# surface (run 17 found this the hard way — `insert` failed with "no focused
# text editor" even though `assert content-live` had already passed).
act Open node in Workbench
settle 20
assert pane workbench
assert surface content
act Share focused node
wait-status 600 Retained history: 2 shared nodes
# The joiner mounts through the projection host once it opens the shared
# knot:// node below.
wait-status 6000 Projection: serving knot to 1 live session

# Wait for the joiner's own revision before authoring this one, so the
# derived digests compared afterward (founder_knot vs joiner_knot) reflect
# both edits on both sides.
wait-file 6000 ${EXCHANGE}\joiner.edited
# Content focus is set only by a real pointer press on the surface, so the
# editor is pressed at its tile: the Knot tile is the right half of the
# workbench beside the shared page (see founder_knot_page.png).
capture founder_knot_page
click-at 890 110
settle 10
key end
key space
insert founder revision
key ctrl+s
wait
assert text saved
record-place founder_knot
touch ${EXCHANGE}\founder.edited

# The returning joiner can only observe the holder going away once this
# process actually exits; wait for its own record of that before ending.
# Also wait for the reader's own refused-dial leg (which needs this process
# alive to be refused by) before exiting.
wait-file 6000 ${EXCHANGE}\knot.done
wait-file 6000 ${EXCHANGE}\reader_knot.finished

act Place status
settle 10
capture founder_final
record-place founder_final

log founder path complete
