# An unselected note retains its address but has no admitted body in this mere.
settle 20
key escape
assert snap network-offline == true
assert snap peer-services == 0
open ${CLIP_NOTE}
settle 30
act Open node in Workbench
settle 20
assert snap browser-current-content == failed
assert snap offline-acquisition-attempts == 0
capture 09_unselected_note_unavailable
log Unselected note reference refused locally without acquiring its source
