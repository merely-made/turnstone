# Both sending app and all package paths are unavailable during this restart.
settle 20
key escape
assert snap network-offline == true
assert snap peer-services == 0
open ${CLIP_KNOT}
settle 30
act Open node in Workbench
settle 20
assert content-live
assert snap browser-current ~ ${CLIP_KNOT}
capture 06_second_mere_knot_reopened
open ${CLIP_VOICE}
settle 30
act Open node in Workbench
settle 20
assert content-live
assert snap browser-current ~ ${CLIP_VOICE}
capture 07_second_mere_voice_reopened
# Two-cell Workbench; verify Play's coordinates against the receiving capture.
click-at 930 145
settle 150
assert snap retained-voice ~ Ended
assert snap offline-acquisition-attempts == 0
capture 08_second_mere_replayed
log Second mere retained selected content after sending app and packages disappeared
