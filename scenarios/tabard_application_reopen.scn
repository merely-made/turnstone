# Fresh process on the accepted profile/library. No product-state writes.
settle 12
key escape
resize 1180 800
settle 5
assert snap appearance-theme == theme:copy-1
assert snap appearance-mode == dark
assert snap appearance-css ~ #142238
act Open Settings pane
settle 5
capture app_reopened_wide
resize 640 780
settle 5
capture app_reopened_narrow
assert snap capture-errors == 0
key escape
assert snap focus == graph
