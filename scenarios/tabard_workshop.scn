# The ordinary Settings action opens this production WorkshopHost.
settle 4
click role:textbox @data-field=name
input-text TurnstoneAcceptance
click role:textbox @data-field=seed-hex
input-text #2F7FFF
click role:button @data-action=apply-hex
click role:button @data-mode=dark
click role:button @data-action=toggle-stylesheet
click role:textbox @data-field=mode-sheet
input-text :root{--tabard-color-bg:#142238;--tabard-color-surface:#1B2E49;--tabard-color-surface-2:#243D5E;--tabard-color-text:#EAF2FF;--tabard-color-text-header:#9CD5FF;--tabard-color-text-dim:#C0D5F2;--tabard-color-primary:#2F7FFF;--tabard-color-on-primary:white;}
click role:button @data-action=apply-stylesheet
settle 4
click .application-canvas
settle 3
capture workshop_authored
resize 640 780
settle 4
click .application-canvas
settle 3
capture workshop_narrow
click role:button @data-action=save
settle 3
assert snap dirty == false
assert snap name == TurnstoneAcceptance
assert snap theme == theme:copy-1
