# L1 metadata-only visit history. New ordinary visits must not put page body
# text into durable recall. Legacy PageText/Answers compatibility is exercised
# by trail_memory's snapshot tests; this lane starts with a FRESH profile.
#
# Start scenarios/fixtures/trail_text_server.ps1 on port 43121 first.
# HAGIOSCOPE and PARBUCKLE appear only in the fixture bodies, not URL/title.
settle 30
key escape
open http://127.0.0.1:43121/notes/7
settle 60
open http://127.0.0.1:43121/notes/8
settle 60

# Address/title history remains useful after visiting.
omnibar find
type /notes/7
settle 40
assert suggestions == 1
assert snap suggestions ~ Field notes
capture 00_address_history_remains_searchable
key escape
settle 10

# The only suggestion is the empty-result hint; neither body is retained.
omnibar find
type hagioscope
settle 40
assert suggestions == 1
assert snap suggestions == no matching nodes; enter an address
capture 01_first_body_term_not_retained
key escape
settle 10
omnibar find
type parbuckle
settle 40
assert suggestions == 1
assert snap suggestions == no matching nodes; enter an address
capture 02_second_body_term_not_retained
key escape
settle 10
